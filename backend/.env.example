# Copy to backend/.env and fill in. Values saved on the Settings page override these.

# Required for image generation and AI analysis. Without it the app runs in DRY RUN mode.
OPENAI_API_KEY=

# Required only when IMAGE_PROVIDER=replicate (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# Root folder containing "raw images", "reference model images" and "Product Images"
JIMIKI_ROOT=D:\JIMIKI\website and ecommerce product images

# live | dry_run
WORKFLOW_MODE=live

IMAGE_WIDTH=1400
IMAGE_HEIGHT=1600
MAX_RETRIES=3
SIMILARITY_THRESHOLD=0.70
GROUPING_CONFIDENCE_THRESHOLD=0.75
ENABLE_PRODUCT_SIMILARITY_CHECK=true
LOG_LEVEL=INFO

# OpenAI models (see Settings page)
ANALYSIS_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-2

# openai | replicate — which service generates the product images
IMAGE_PROVIDER=openai
REPLICATE_IMAGE_MODEL=xai/grok-imagine-image
IMAGE_QUALITY=high

# Name shown in the dashboard header
OPERATOR_NAME=Studio Admin

# Set to 1 to use a polling watcher (e.g. network drives that do not emit file events)
JIMIKI_POLLING=0
